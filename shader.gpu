

// Vertex shader
const vertexShaderSource = `
attribute vec3 vertex;
attribute vec3 normal;
attribute vec2 texCoord;
attribute vec3 tangent;

uniform mat4 normalMatrix;
uniform mat4 ModelViewProjectionMatrix;

varying vec3 var_position;
varying vec3 var_normal;
varying vec3 var_tangent;
varying vec3 var_bitangent;
varying vec2 var_texCoord;

void main() {
    vec4 pos = ModelViewProjectionMatrix * vec4(vertex,1.0);
    var_position = pos.xyz;
    var_texCoord = texCoord;

    vec3 N = normalize((normalMatrix * vec4(normal, 0.0)).xyz);
    vec3 T = normalize((normalMatrix * vec4(tangent, 0.0)).xyz);
    T = normalize(T - dot(T,N) * N);
    vec3 B = cross(N, T);

    var_normal = N;
    var_tangent = T;
    var_bitangent = B;

    gl_Position = pos;
}`;


// Fragment shader
const fragmentShaderSource = `
#ifdef GL_FRAGMENT_PRECISION_HIGH
   precision highp float;
#else
   precision mediump float;
#endif

varying vec3 var_position;
varying vec3 var_normal;
varying vec3 var_tangent;
varying vec3 var_bitangent;
varying vec2 var_texCoord;

uniform vec3 lightPos;
uniform sampler2D diffuseTexture;
uniform sampler2D specularTexture;
uniform sampler2D normalTexture;

void main() {
    vec3 viewerPos = vec3(10.0, 0.0, 10.0);
    float shininess = 80.0;
    float kA = 1.0;
    float kD = 1.0;
    float kS = 1.0;

    vec3 normalMap = texture2D(normalTexture, var_texCoord).rgb * 2.0 - 1.0;
    mat3 TBN = mat3(var_tangent, var_bitangent, var_normal);
    vec3 normal = normalize(TBN * normalMap);

    vec3 lightDir = normalize(lightPos - var_position);
    vec3 viewDir = normalize(viewerPos - var_position);

    // Ambient
    vec3 ambient = vec3(0.2, 0.09, 0.0);

    // Diffuse
    float diff = max(dot(normal, lightDir), 0.0);
    vec3 diffuse = diff * texture2D(diffuseTexture, var_texCoord).rgb;

    // Specular
    vec3 reflectDir = reflect(-lightDir, normal);
    float spec = pow(max(dot(viewDir, reflectDir), 0.0), shininess);
    vec3 specular = spec * texture2D(specularTexture, var_texCoord).rgb;

    vec3 result = ambient + diffuse + specular;
    gl_FragColor = vec4(result, 1.0);
}`;